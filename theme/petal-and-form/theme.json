{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Blush Atelier",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Ivory", "color": "#FBF8F3" },
				{ "slug": "base-2", "name": "Cream", "color": "#F4EEE5" },
				{ "slug": "tint-1", "name": "Powder pink", "color": "#F1DDE1" },
				{ "slug": "tint-2", "name": "Sage mist", "color": "#DCE5D8" },
				{ "slug": "tint-3", "name": "Lavender haze", "color": "#E8E1F1" },
				{ "slug": "tint-4", "name": "Butter", "color": "#F5EAC8" },
				{ "slug": "accent", "name": "Dusty rose (decorative)", "color": "#C88F98" },
				{ "slug": "primary", "name": "Rosewood", "color": "#8A4E5A" },
				{ "slug": "contrast", "name": "Charcoal", "color": "#35312F" },
				{ "slug": "contrast-2", "name": "Stone", "color": "#625C58" },
				{ "slug": "border", "name": "Linen", "color": "#E6DCD2" }
			],
			"gradients": [
				{
					"slug": "blush-wash",
					"name": "Blush wash",
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--tint-1) 0%, var(--wp--preset--color--base) 70%)"
				},
				{
					"slug": "garden-wash",
					"name": "Garden wash",
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--tint-2) 0%, var(--wp--preset--color--tint-4) 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgb(53 49 47 / 0.04), 0 12px 32px -16px rgb(53 49 47 / 0.22)"
				},
				{
					"slug": "lifted",
					"name": "Lifted",
					"shadow": "0 2px 4px rgb(53 49 47 / 0.05), 0 24px 48px -20px rgb(53 49 47 / 0.28)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "XXS", "size": "0.5rem" },
				{ "slug": "20", "name": "XS", "size": "0.75rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.5rem, 3vw, 2.25rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2rem, 5vw, 3.5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3rem, 7vw, 5.5rem)" },
				{ "slug": "80", "name": "XXXL", "size": "clamp(4rem, 10vw, 8rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-500-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-ext-500-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-600-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-ext-600-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-500-italic.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cormorant-garamond-latin-ext-500-italic.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-latin-wght-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "normal",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-latin-ext-wght-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-latin-wght-italic.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "DM Sans",
							"fontStyle": "italic",
							"fontWeight": "100 1000",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/dm-sans-latin-ext-wght-italic.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "system",
					"name": "System sans (no web font)",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-serif",
					"name": "System serif (no web font)",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Large", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
				{ "slug": "xxx-large", "name": "Hero", "size": "5rem", "fluid": { "min": "2.75rem", "max": "5rem" } }
			]
		},
		"custom": {
			"radius": {
				"small": "8px",
				"medium": "16px",
				"large": "28px",
				"button": "999px"
			},
			"motion": {
				"duration": "220ms",
				"ease": "cubic-bezier(0.22, 1, 0.36, 1)"
			},
			"eyebrow": {
				"letter-spacing": "0.16em",
				"transform": "uppercase"
			},
			"card": {
				"image-ratio": "4/5"
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--primary)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "1.25rem", "lineHeight": "1.3", "fontWeight": "600" } },
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"letterSpacing": "0.04em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "600",
					"lineHeight": "1.4",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--contrast)"
				},
				"spacing": {
					"padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.75em", "right": "1.75em" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "0.02em",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": { "color": "var(--wp--preset--color--primary)" }
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)", "lineHeight": "1.5" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "0.01em"
				},
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/post-title": {
				"elements": {
					"link": { "typography": { "textDecoration": "none" } }
				}
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" }
			},
			"core/image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var(--wp--custom--radius--medium)" }
			},
			"core/cover": {
				"border": { "radius": "var(--wp--custom--radius--large)" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var(--wp--preset--color--accent)", "width": "2px", "style": "solid" }
				},
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--40)" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "1.35"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--body)",
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal"
						}
					}
				}
			},
			"core/pullquote": {
				"border": { "width": "0" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.25"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--border)" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/search": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"border": { "radius": "var(--wp--custom--radius--button)" }
			},
			"core/details": {
				"border": {
					"bottom": { "color": "var(--wp--preset--color--border)", "width": "1px", "style": "solid" }
				},
				"spacing": { "padding": { "top": "var(--wp--preset--spacing--30)", "bottom": "var(--wp--preset--spacing--30)" } }
			},
			"core/query-pagination": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" }
			},
			"core/comment-author-name": {
				"typography": { "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "post-meta", "title": "Post meta", "area": "uncategorized" },
		{ "name": "comments", "title": "Comments", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Landing page (no title, full width)", "postTypes": [ "page" ] }
	]
}
